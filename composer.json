{
    "name": "revx-php/revx-php",
    "description": "A small PHP client for the Revolut X REST API.",
    "type": "library",
    "license": "MIT",
    "keywords": ["revolut", "revolut-x", "crypto", "trading", "api"],
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Revx\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Revx\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
